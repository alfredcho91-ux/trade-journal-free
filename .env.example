# Copy this file to .env. Create a Deepcoin key with read-only permission.
DEEPCOIN_API_KEY=
DEEPCOIN_SECRET_KEY=
DEEPCOIN_PASSPHRASE=
DEEPCOIN_API_BASE_URL=https://api.deepcoin.com

# Local development ports. Defaults avoid collisions with the full Quant-Lab app.
JOURNAL_HOST=127.0.0.1
JOURNAL_BACKEND_PORT=8011
JOURNAL_FRONTEND_PORT=5181

# Required only when APP_ENV=production.
APP_ENV=development
DEMO_USERNAME=
DEMO_PASSWORD=
