# Copy this file to .env. Every exchange key must be read-only.
# Never commit real values. Server deployments should inject these as platform secrets.
DEEPCOIN_API_KEY=
DEEPCOIN_SECRET_KEY=
DEEPCOIN_PASSPHRASE=
DEEPCOIN_API_BASE_URL=https://api.deepcoin.com

BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

BYBIT_API_KEY=
BYBIT_SECRET_KEY=
BYBIT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Credential persistence. Desktop defaults to OS keyring; production auto uses encrypted_db.
CREDENTIAL_STORAGE=auto
# URL-safe base64 encoding of exactly 32 random bytes. Leave blank in this example.
CREDENTIAL_MASTER_KEY=

# Local development ports. Defaults avoid collisions with the full Quant-Lab app.
JOURNAL_HOST=127.0.0.1
JOURNAL_BACKEND_PORT=8011
JOURNAL_FRONTEND_PORT=5181

# Required only when APP_ENV=production.
APP_ENV=development
TRUST_PROXY_HEADERS=false
DEMO_USERNAME=
DEMO_PASSWORD=
