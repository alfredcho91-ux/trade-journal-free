<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <!--
    Partner Center values only. Replace through build-msix.ps1 parameters;
    do not invent either value.
  -->
  <Identity
    Name="TODO_PARTNER_CENTER_IDENTITY_NAME"
    Publisher="TODO_PARTNER_CENTER_PUBLISHER"
    Version="1.0.24.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Trade Journal Free</DisplayName>
    <PublisherDisplayName>TODO: Partner Center publisher display name</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- The executable and _internal directory are copied unchanged from the inspected ZIP. -->
    <Application Id="App" Executable="Trade Journal Free.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Trade Journal Free"
        Description="Trade Journal Free"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension
          Category="windows.fullTrustProcess"
          Executable="Trade Journal Free.exe"
          EntryPoint="Windows.FullTrustApplication" />
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
